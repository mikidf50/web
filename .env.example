# Neon PostgreSQL Connection URL
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Admin Server Secret: used for cryptographically secure session signatures and backend verification
ADMIN_SERVER_SECRET="mela_market_admin_server_secret_key"

# Admin Setup Master Key: used for initial administrator verification and elevated operations
ADMIN_SETUP_MASTER_KEY="mela_admin_master_setup_key"

# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
